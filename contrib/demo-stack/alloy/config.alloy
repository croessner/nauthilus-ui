logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "demo" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "nauthilus_logs" {
  targets = discovery.docker.demo.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(nauthilus|nauthilus-ui)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    target_label = "job"
    replacement  = "nauthilus-ui-demo"
  }
}

loki.source.docker "nauthilus_demo" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.nauthilus_logs.output
  labels     = {"platform" = "docker"}
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
