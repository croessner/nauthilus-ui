# MongoDB Configuration
MONGODB_ROOT_USER=nauthilus
MONGODB_ROOT_PASSWORD=nauthilus_password
MONGODB_URI=mongodb://${MONGODB_ROOT_USER}:${MONGODB_ROOT_PASSWORD}@localhost:27017/nauthilus-ui?authSource=admin

# Server Configuration
PORT=3000
ADDRESS=0.0.0.0

EXPRESS_PORT=3001
EXPRESS_ADDRESS=0.0.0.0

# JWT configuration
REACT_APP_JWT_SECRET=your_secure_jwt_secret_key_here
REACT_APP_TOKEN_EXPIRY=3600
REACT_APP_REFRESH_TOKEN_EXPIRY=86400

# Note: For production, copy this file to .env.local or .env.production
# and set secure values for the passwords and secrets.
