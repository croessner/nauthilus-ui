# MongoDB Configuration
MONGODB_ROOT_USER=nauthilus
MONGODB_ROOT_PASSWORD=nauthilus_password
MONGODB_URI=mongodb://${MONGODB_ROOT_USER}:${MONGODB_ROOT_PASSWORD}@localhost:27017/nauthilus-ui?authSource=admin

# Server Configuration
# Frontend server
FRONTEND_PORT=3001
FRONTEND_ADDRESS=0.0.0.0

# Proxy server
PROXY_PORT=3002
PROXY_ADDRESS=0.0.0.0
# REACT_APP_PROXY_PORT=3002
# Explicit browser-origin allowlist for cross-origin requests.
# Leave unset for local dev defaults only (localhost/127.0.0.1 on ports 3000/3001/3002).
# In deployments behind a real hostname/TLS proxy, set this explicitly.
# CORS_ALLOWED_ORIGINS=https://ui.example.com,https://admin.example.com

# Reverse-proxy IPs/CIDRs whose Forwarded/X-Forwarded-* headers may be trusted.
# Leave unset to trust no proxy headers. Required behind TLS terminators/load balancers
# if callback URLs, secure cookies, audit IPs or rate limits should use forwarded values.
# TRUSTED_PROXIES=127.0.0.1,::1,172.18.0.0/16

# WebAuthn settings
WEBAUTHN_RP_ID=your_domain.com
WEBAUTHN_RP_DISPLAY_NAME=Your Application Name
WEBAUTHN_RP_ORIGINS=https://your_domain.com

# JWT configuration
REACT_APP_JWT_SECRET=your_secure_jwt_secret_key_here
REACT_APP_TOKEN_EXPIRY=3600
REACT_APP_REFRESH_TOKEN_EXPIRY=86400
# Remember-me cookie/token lifespan (seconds)
REACT_APP_REMEMBER_ME_EXPIRY=86400
# Cookie banner re-show policy:
#   -1 = never show
#    0 = always show (user can dismiss for the current session)
#    N = show again after N days
REACT_APP_COOKIE_BANNER_RESHOW_DAYS=-1

# OIDC (optional)
# Enable OIDC login flow (set to "true" to enable)
REACT_APP_OIDC_ENABLED=false
# Issuer URL of your OpenID Provider (e.g., Keycloak realm, Auth0, etc.)
# Example (Keycloak): https://auth.example.com/realms/myrealm
REACT_APP_OIDC_ISSUER=
# Client ID registered with your OIDC provider
REACT_APP_OIDC_CLIENT_ID=
# Client Secret (required for server-side code flow without PKCE)
REACT_APP_OIDC_CLIENT_SECRET=
# The backend callback redirect URI is fixed at:
#   http(s)://<host>/api/auth/oidc/callback
# Configure this callback URL in your OIDC provider. The backend will
# then redirect the browser to the frontend route /oidc/callback.
# Space-separated scopes to request
REACT_APP_OIDC_SCOPES=openid profile email
# Claim path from which to extract roles. Examples:
#  - roles
#  - realm_access.roles (Keycloak default)
REACT_APP_OIDC_ROLE_CLAIM=roles
# Claim used as username. Common values: preferred_username, email, sub
REACT_APP_OIDC_USERNAME_CLAIM=preferred_username

# Note: For production, copy this file to .env.local or .env.production
# and set secure values for the passwords and secrets.
