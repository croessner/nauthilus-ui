    "e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "smoke:auth": "node scripts/smoke.auth-endpoints.test.mjs",
    "deps:outdated": "npm outdated || true",
    "deps:deprecated": "npx npm-check-updates --deprecated",
    "deps:audit": "npm audit || true",
    "deps:check": "npm run deps:outdated && npm run deps:deprecated && npm run deps:audit",
    "deps:upgrade:minor": "npx npm-check-updates --target minor -u && npm i",
    "deps:upgrade:latest": "npx npm-check-updates --target latest -u && npm i",
    "deps:upgrade:i": "npx npm-check-updates --interactive",
    "deps:dedupe": "npm dedupe",
    "postdeps:verify": "npm run build",
    "deps:safe-upgrade": "npm run deps:upgrade:minor && npm run postdeps:verify",
    "deps:update": "bash scripts/update-deps.sh"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
